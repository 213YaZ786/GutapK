#!/bin/sh
# The jpackage native launcher segfaults on glibc 2.42 and later. This script
# reads the same .cfg the launcher would and calls the bundled java directly.
#
# Nothing here assumes where jpackage puts the runtime: the expected paths are
# tried first, then the whole tree is searched. A wrong guess cost a release.
set -eu

HERE=$(dirname "$(readlink -f "$0")")
ROOT=$(cd "$HERE/.." && pwd)

find_first() {
    find "$ROOT" -type f -name "$1" -perm -u+x 2>/dev/null | head -n 1
}

JAVA=""
for c in "$ROOT/lib/runtime/bin/java" "$ROOT/runtime/bin/java" \
         "$ROOT/lib/app/runtime/bin/java" "$ROOT/lib/jvm/bin/java"
do
    if [ -x "$c" ]; then JAVA="$c"; break; fi
done
[ -n "$JAVA" ] || JAVA=$(find_first java)
if [ -z "$JAVA" ]; then
    echo "gutapk: no java runtime under $ROOT" >&2
    find "$ROOT" -maxdepth 3 >&2
    exit 1
fi

CFG=""
for f in "$ROOT"/lib/app/*.cfg "$ROOT"/lib/*.cfg "$ROOT"/app/*.cfg
do
    if [ -f "$f" ]; then CFG="$f"; break; fi
done
if [ -z "$CFG" ]; then
    CFG=$(find "$ROOT" -type f -name '*.cfg' 2>/dev/null | head -n 1)
fi
if [ -z "$CFG" ]; then
    echo "gutapk: no .cfg under $ROOT" >&2
    find "$ROOT" -maxdepth 3 >&2
    exit 1
fi

# $APPDIR inside a .cfg means the directory holding the cfg, not the AppImage
# mount point. Same name, different thing.
APP=$(dirname "$CFG")

MAIN=""
MODULE=""
CP=""
OPTS=""

expand() {
    printf '%s' "$1" | sed -e "s|\$APPDIR|$APP|g" -e "s|\$ROOTDIR|$ROOT|g"
}

while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        \[*\]|'') continue ;;
        *=*) ;;
        *) continue ;;
    esac
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
        app.mainclass) MAIN=$(expand "$val") ;;
        app.mainmodule) MODULE=$(expand "$val") ;;
        app.classpath)
            val=$(expand "$val")
            case "$val" in /*) ;; *) val="$APP/$val" ;; esac
            if [ -z "$CP" ]; then CP="$val"; else CP="$CP:$val"; fi
            ;;
        java-options) OPTS="$OPTS $(expand "$val")" ;;
    esac
done < "$CFG"

if [ -n "$MODULE" ]; then
    # shellcheck disable=SC2086
    exec "$JAVA" $OPTS -p "$CP" -m "$MODULE" "$@"
fi
[ -n "$MAIN" ] || { echo "gutapk: no main class in $CFG" >&2; exit 1; }
# shellcheck disable=SC2086
exec "$JAVA" $OPTS -cp "$CP" "$MAIN" "$@"
